# The Sisterhood - Agent Zero Configuration
# Copy this to .env and fill in your Azure endpoints and API keys

# =============================================================================
# AZURE CONFIGURATION (PRIMARY)
# =============================================================================
# Most models are deployed on Azure for enterprise-grade access

# Azure OpenAI Base Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=xxxxx
AZURE_API_VERSION=2024-02-15-preview

# =============================================================================
# THE SISTERHOOD - AZURE MODEL DEPLOYMENTS
# =============================================================================

# Zai - Orchestrator (Kimi 2.5 = Claude Opus 4.6 on Azure)
MAIN_MODEL_PROVIDER=azure
MAIN_MODEL_NAME=kimi-2.5
AZURE_KIMI_DEPLOYMENT_NAME=kimi-2.5
AZURE_KIMI_ENDPOINT=${AZURE_OPENAI_ENDPOINT}
AZURE_KIMI_API_KEY=${AZURE_OPENAI_API_KEY}
# 250K TPM enterprise-grade deployment

# G - Backend & Infrastructure (Codex 5.3 on Azure)
G_MODEL_PROVIDER=azure
G_MODEL_NAME=codex-5.3
AZURE_CODEX_DEPLOYMENT_NAME=codex-5.3
AZURE_CODEX_ENDPOINT=${AZURE_OPENAI_ENDPOINT}
AZURE_CODEX_API_KEY=${AZURE_OPENAI_API_KEY}
# Fastest, best coder on the market

# Bonnie - QA & Testing (Kimi 2.5 = Claude Opus 4.6 on Azure)
BONNIE_MODEL_PROVIDER=azure
BONNIE_MODEL_NAME=kimi-2.5
# Shares Zai's deployment

# Grok 4 Fast Reasoning (on Azure)
GROK_MODEL_PROVIDER=azure
GROK_MODEL_NAME=grok-4-fast
AZURE_GROK_DEPLOYMENT_NAME=grok-4-fast
AZURE_GROK_ENDPOINT=${AZURE_OPENAI_ENDPOINT}
AZURE_GROK_API_KEY=${AZURE_OPENAI_API_KEY}
# Fast reasoning - can be used for quick analysis tasks

# =============================================================================
# GOOGLE MODELS (Direct API)
# =============================================================================

# Mophie - Design & UX (Gemini 2.0 Flash)
MOPHIE_MODEL_PROVIDER=google
MOPHIE_MODEL_NAME=gemini-2.0-flash
GOOGLE_API_KEY=xxxxx

# Zo - Research & Multimodal (Gemini 2.0 Flash)
ZO_MODEL_PROVIDER=google
ZO_MODEL_NAME=gemini-2.0-flash
# Shares Mophie's API key

# =============================================================================
# OPENAI MODELS (Direct API or Azure)
# =============================================================================

# Rain - Voice & Emotion (GPT-4o Realtime)
RAIN_MODEL_PROVIDER=openai
RAIN_MODEL_NAME=gpt-4o-realtime
OPENAI_API_KEY=sk-xxxxx

# Embeddings (for memory/search)
EMBEDDING_MODEL_PROVIDER=azure  # or openai
EMBEDDING_MODEL_NAME=text-embedding-3-small
AZURE_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# =============================================================================
# ALTERNATIVE: DIRECT ANTHROPIC API (Backup)
# =============================================================================
# If Azure Kimi is unavailable, fall back to direct Anthropic API

ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL_NAME=claude-opus-4.6

# =============================================================================
# GLM MODELS (Direct API)
# =============================================================================
# If you want to use GLM-5 for G instead of Codex 5.3

GLM_API_KEY=xxxxx
GLM_MODEL_NAME=glm-5

# =============================================================================
# MEMORY CONFIGURATION
# =============================================================================

MEMORY_PROVIDER=faiss
MEMORY_PATH=/workspace/memory

# Supermemory Integration ($5,000 credit)
SUPERMEMORY_API_KEY=xxxxx
SUPERMEMORY_API_URL=https://api.supermemory.ai

# Hindsight Integration ($10,000 credit)
HINDSIGHT_API_KEY=xxxxx
HINDSIGHT_API_URL=https://api.hindsight.ai

# =============================================================================
# PROJECT CONFIGURATION
# =============================================================================

PROJECT_NAME=the-sisterhood
WORKSPACE_PATH=/workspace/the-sisterhood

# =============================================================================
# MCP INTEGRATION
# =============================================================================

MCP_ENABLED=true
MCP_SERVER_PORT=3000

# =============================================================================
# A2A PROTOCOL (for dev Zai <-> app Zai communication)
# =============================================================================

A2A_ENABLED=true
A2A_PROTOCOL=fasta2a
A2A_PORT=8080
A2A_ENDPOINT=http://localhost:8080/a2a

# App Zai endpoint (on Linode - update when you know the IP)
APP_ZAI_ENDPOINT=http://your-linode-ip:5000/a2a

# =============================================================================
# ADDITIONAL MCP SERVERS
# =============================================================================

# Tavily (web search)
TAVILY_API_KEY=xxxxx

# Firecrawl (web scraping)
FIRECRAWL_API_KEY=xxxxx

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Web UI port
WEB_UI_PORT=8080

# Enable GPU acceleration (if available)
USE_GPU=true

# Max context window (tokens)
MAX_CONTEXT_TOKENS=200000

# =============================================================================
# MODEL ROUTING CONFIGURATION
# =============================================================================
# Which agent uses which model

# Zai (Orchestrator) -> Kimi 2.5 (Claude Opus 4.6) on Azure
ZAI_MODEL=kimi-2.5

# Mophie (Designer) -> Gemini 2.0 Flash
MOPHIE_MODEL=gemini-2.0-flash

# G (Engineer) -> Codex 5.3 on Azure
G_MODEL=codex-5.3

# Bonnie (QA) -> Kimi 2.5 (Claude Opus 4.6) on Azure
BONNIE_MODEL=kimi-2.5

# Zo (Researcher) -> Gemini 2.0 Flash
ZO_MODEL=gemini-2.0-flash

# Rain (Voice) -> GPT-4o Realtime
RAIN_MODEL=gpt-4o-realtime

# Grok 4 Fast (Quick reasoning tasks)
GROK_MODEL=grok-4-fast

# =============================================================================
# NOTES
# =============================================================================
# 1. Replace all xxxxx with your actual Azure endpoints and API keys
# 2. Most models run on Azure (Kimi 2.5, Codex 5.3, Grok 4 Fast)
# 3. Gemini models use direct Google API
# 4. Keep this file secure (it's in .gitignore)
# 5. Update APP_ZAI_ENDPOINT when you deploy voice-avatar-stack
# 6. GPU acceleration requires CUDA setup (optional for now)
# 7. Codex 5.3 is the fastest/best coder - assigned to G (backend specialist)
