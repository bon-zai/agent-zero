# The Sisterhood - Agent Zero Configuration
# Copy this to .env and fill in your API keys

# =============================================================================
# MAIN MODEL (Zai - Claude Opus 4.6)
# =============================================================================
MAIN_MODEL_PROVIDER=anthropic
MAIN_MODEL_NAME=claude-opus-4.6
ANTHROPIC_API_KEY=sk-ant-xxxxx

# =============================================================================
# UTILITY MODEL (for quick tasks)
# =============================================================================
UTILITY_MODEL_PROVIDER=anthropic
UTILITY_MODEL_NAME=claude-3-5-sonnet-20241022

# =============================================================================
# EMBEDDING MODEL (for memory/search)
# =============================================================================
EMBEDDING_MODEL_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-3-small
OPENAI_API_KEY=sk-xxxxx

# =============================================================================
# THE SISTERHOOD MODELS
# =============================================================================

# Mophie - Design & UX (Gemini 2.0 Flash)
GOOGLE_API_KEY=xxxxx

# G - Backend & Infrastructure (GLM-5)
GLM_API_KEY=xxxxx

# Rain - Voice & Emotion (GPT-4o Realtime)
# Uses OPENAI_API_KEY above

# =============================================================================
# MEMORY CONFIGURATION
# =============================================================================
MEMORY_PROVIDER=faiss
MEMORY_PATH=/workspace/memory

# Supermemory Integration ($5,000 credit)
SUPERMEMORY_API_KEY=xxxxx
SUPERMEMORY_API_URL=https://api.supermemory.ai

# Hindsight Integration ($10,000 credit)
HINDSIGHT_API_KEY=xxxxx
HINDSIGHT_API_URL=https://api.hindsight.ai

# =============================================================================
# PROJECT CONFIGURATION
# =============================================================================
PROJECT_NAME=the-sisterhood
WORKSPACE_PATH=/workspace/the-sisterhood

# =============================================================================
# MCP INTEGRATION
# =============================================================================
MCP_ENABLED=true
MCP_SERVER_PORT=3000

# =============================================================================
# A2A PROTOCOL (for dev Zai <-> app Zai communication)
# =============================================================================
A2A_ENABLED=true
A2A_PROTOCOL=fasta2a
A2A_PORT=8080
A2A_ENDPOINT=http://localhost:8080/a2a

# App Zai endpoint (on Linode - update when you know the IP)
APP_ZAI_ENDPOINT=http://your-linode-ip:5000/a2a

# =============================================================================
# ADDITIONAL MCP SERVERS
# =============================================================================

# Tavily (web search)
TAVILY_API_KEY=xxxxx

# Firecrawl (web scraping)
FIRECRAWL_API_KEY=xxxxx

# Azure (if using Azure endpoints)
AZURE_API_KEY=xxxxx
AZURE_ENDPOINT=xxxxx

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Web UI port
WEB_UI_PORT=8080

# Enable GPU acceleration (if available)
USE_GPU=true

# Max context window (tokens)
MAX_CONTEXT_TOKENS=200000

# =============================================================================
# NOTES
# =============================================================================
# 1. Replace all xxxxx with your actual API keys
# 2. Keep this file secure (it's in .gitignore)
# 3. Update APP_ZAI_ENDPOINT when you deploy voice-avatar-stack
# 4. GPU acceleration requires CUDA setup (optional for now)
